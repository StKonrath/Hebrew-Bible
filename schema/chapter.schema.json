{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/hebrew-bible/chapter.schema.json",
  "title": "Hebrew Bible Chapter (Spec v1.3)",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "spec_version",
    "tagset",
    "book",
    "book_slug",
    "chapter",
    "ref_system",
    "verses",
    "lexicon",
    "grammar",
    "exercises",
    "annotations",
    "generated_at"
  ],
  "properties": {
    "spec_version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+(\\.\\d+)?$"
    },
    "tagset": {
      "type": "object",
      "required": [
        "name",
        "version"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "version": {
          "type": "string"
        }
      },
      "additionalProperties": true
    },
    "book": {
      "type": "string",
      "minLength": 1
    },
    "book_slug": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "chapter": {
      "type": "integer",
      "minimum": 1
    },
    "ref_system": {
      "type": "string",
      "minLength": 1
    },
    "subtitle": {
      "type": "string"
    },
    "verses": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": true,
        "required": [
          "ref",
          "he",
          "en",
          "tr",
          "tokens",
          "semantic_summary"
        ],
        "properties": {
          "ref": {
            "type": "string",
            "pattern": "^\\d+:\\d+[a-z]?$"
          },
          "he": {
            "type": "string",
            "minLength": 1
          },
          "en": {
            "type": "string"
          },
          "tr": {
            "type": "string"
          },
          "tokens": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/token"
            }
          },
          "semantic_summary": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "lexicon": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true
      }
    },
    "grammar": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true
      }
    },
    "exercises": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true
      }
    },
    "annotations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true
      }
    },
    "generated_at": {
      "type": "string",
      "minLength": 4
    }
  },
  "$defs": {
    "token": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "id",
        "surface",
        "lemma",
        "root",
        "pos",
        "features",
        "morph",
        "gloss",
        "semantic"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*\\.\\d{2}\\.\\d{2}\\.t\\d{3}$"
        },
        "surface": {
          "type": "string",
          "minLength": 1
        },
        "lemma": {
          "type": "string",
          "minLength": 1
        },
        "root": {
          "type": "string",
          "minLength": 1
        },
        "pos": {
          "type": "string",
          "minLength": 1
        },
        "features": {
          "type": "object",
          "additionalProperties": true
        },
        "morph": {
          "type": "string",
          "minLength": 1
        },
        "gloss": {
          "type": "string"
        },
        "semantic": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    }
  }
}